# ==========================================================================
# Orbit — local development environment TEMPLATE
# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
#   # generate a strong secret:  openssl rand -hex 32
# Nx auto-loads .env for `nx serve` / `nx run` tasks.
# ==========================================================================

# --- Authentication (shared: every service verifies the JWT locally) ---
JWT_SECRET=secret

# --- PostgreSQL credentials (match infra/postgres/init/01-init-databases.sql) ---
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit

# --- RabbitMQ (Pub/Sub) — management UI at http://localhost:15672 ---
RABBITMQ_URL=amqp://orbit:orbit@localhost:5672

# --------------------------------------------------------------------------
# Per-service values below target users-service (the implemented service).
# As other services come online, put their PORT/DATABASE_URL/GRPC_URL in
# apps/<service>/.env — Nx loads root .env AND apps/<svc>/.env per task.
# --------------------------------------------------------------------------

# users-service  (REST :3001 / gRPC 50051 / db_users)
PORT=3001
DATABASE_URL=postgres://orbit:orbit@localhost:5432/db_users
GRPC_URL=0.0.0.0:50051

# Reference — other services (use in their own apps/<svc>/.env):
# content-service        PORT=3002  GRPC_URL=0.0.0.0:50052  DATABASE_URL=postgres://orbit:orbit@localhost:5432/db_content        USERS_GRPC_URL=localhost:50051
# chat-service           PORT=3003  GRPC_URL=0.0.0.0:50053  DATABASE_URL=postgres://orbit:orbit@localhost:5432/db_chat            USERS_GRPC_URL=localhost:50051
# notifications-service  PORT=3004  GRPC_URL=0.0.0.0:50054  DATABASE_URL=postgres://orbit:orbit@localhost:5432/db_notifications
